# Copiar como backend/.env y completar. Nunca subir .env al repositorio.
APP_ENV=development
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true cuando la plataforma se sirva por HTTPS (obligatorio con APP_ENV=production)
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=60

# Límites de uso
AUDIT_RATE_PER_HOUR=20
LOGIN_RATE_PER_15MIN=10
EMAIL_RATE_PER_HOUR=5
MAX_CONCURRENT_AUDITS=2
AUDIT_TIMEOUT_SECONDS=45

# Conservación de datos
GUEST_RETENTION_HOURS=24
USER_RETENTION_DAYS=180

# Correo (opcional; si SMTP_HOST queda vacío, el envío se informa como no disponible)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Solo si el frontend se sirve desde otro dominio (separados por coma). Vacío = mismo origen.
ALLOWED_ORIGINS=
